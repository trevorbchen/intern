# Copy to .env (gitignored) and fill in. NEVER commit .env.
X_USERNAME=
X_PASSWORD=
X_VERIFY=
# or: X_AUTH_TOKEN= / X_CT0=
INTERNBOT_WEBHOOK=
# Claude writes answers to application questions your profile patterns don't cover
ANTHROPIC_API_KEY=
# optional; default claude-opus-5-5. Cheaper: claude-sonnet-5-5 or claude-haiku-5-5
ANTHROPIC_MODEL=
# Free key from openalex.org (account -> API key); used to find similar researchers
OPENALEX_API_KEY=
# Free phone push alerts: install the ntfy app, subscribe to a random topic name, put it here
NTFY_TOPIC=
